# Copy to .env and fill in. NEVER commit the real .env file.

# Port. Render sets this automatically in production — leave it unset there.
PORT=4000

# Set to "production" on a deployed service. This makes default PINs a startup failure
# rather than a warning, and disables the demo reset endpoint.
NODE_ENV=development

# Shared PINs, one per role. Documented demo simplification — see PORTAL_SPEC.md 3.3.
# The service refuses to start in production while these are the defaults.
OFFICER_PIN=4471
TRADER_PIN=1001

# Where records are persisted. Point at a mounted disk for persistence across redeploys.
# DATA_FILE=./data/consignments.json

# TESTING SWITCH — currently ON by default in development.
# While on, declaration fields are not checked against their trade formats (HS code,
# UN/LOCODE, IMO number, LC reference, country, unit, currency). Required fields, length
# limits and number checks still apply, and status names are always enforced.
# Set to false to get the real checks back. Forced off in production regardless.
RELAXED=true

# SESSION_TTL_MINUTES=30
# SIGNIN_LIMIT=20
# CORS_ORIGINS=*
